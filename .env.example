# Local development environment. Copy to `.env` and fill in values.

# Required for real model calls. Automated tests use a mock server instead.
DEEPSEEK_API_KEY=

# Main model route. Defaults are development-only; the NixOS module owns these
# values in production.
NOKORIBI_PROVIDER=deepseek-official
NOKORIBI_MODEL=deepseek-flash

# Reviewer routes. Fast reviews every tool call; strong re-reviews denials,
# ambiguity, and sudo/root actions. Omit to reuse the main route.
# NOKORIBI_REVIEW_FAST_MODEL=
# NOKORIBI_REVIEW_STRONG_MODEL=
# NOKORIBI_REVIEW_FAST_REASONING_EFFORT=
# NOKORIBI_REVIEW_STRONG_REASONING_EFFORT=
# NOKORIBI_REVIEW_TIMEOUT_MS=30000

# Text interaction deadlines (milliseconds).
# NOKORIBI_APPROVAL_TIMEOUT_MS=60000
# NOKORIBI_QUESTION_TIMEOUT_MS=300000

# Local test channel. The daemon refuses to start without a token.
NOKORIBI_TEST_TOKEN=
NOKORIBI_TEST_PORT=8787

# Optional paths.
# NOKORIBI_WORKSPACE=
# NOKORIBI_SOUL_FILE=
# NOKORIBI_TEMPLATES_DIR=
# NOKORIBI_PATCH=
