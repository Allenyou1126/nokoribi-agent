# Local development environment. Copy to `.env` and fill in values.

# Required for real model calls. Automated tests use a mock server instead.
DEEPSEEK_API_KEY=

# Main model route. Defaults are development-only; the NixOS module owns these
# values in production.
NOKORIBI_PROVIDER=deepseek-official
NOKORIBI_MODEL=deepseek-flash

# Reviewer routes. Fast reviews every tool call; strong re-reviews denials,
# ambiguity, and sudo/root actions. Omit to reuse the main route.
# NOKORIBI_REVIEW_FAST_MODEL=
# NOKORIBI_REVIEW_STRONG_MODEL=
# NOKORIBI_REVIEW_FAST_REASONING_EFFORT=
# NOKORIBI_REVIEW_STRONG_REASONING_EFFORT=
# NOKORIBI_REVIEW_TIMEOUT_MS=30000
# Tools exempt from Auto review under the danger-full-access preset (D170).
# Only read-only external-content tools are exempted; terminal_*/bash/fs and
# the other tools stay reviewed. An empty value restores full review.
# NOKORIBI_REVIEW_EXEMPT_TOOLS=web_search,web_fetch

# Text interaction deadlines (milliseconds).
# NOKORIBI_APPROVAL_TIMEOUT_MS=60000
# NOKORIBI_QUESTION_TIMEOUT_MS=300000

# Local test channel. The daemon refuses to start without a token.
NOKORIBI_TEST_TOKEN=
NOKORIBI_TEST_PORT=8787

# QQ official bot (M8). Disabled by default; review the platform constraints
# before enabling. Admission relies on the QQ platform only: there is no
# driver-level allowlist, so any user who can message the bot or @-mention it
# can drive the agent (D152 accepted residual risk).
# NOKORIBI_QQ_BOT_ENABLED=false
# NOKORIBI_QQ_BOT_APP_ID=
# Client secret: read at runtime from this environment variable only. In
# production provide it through the systemd EnvironmentFile (agenix); never
# commit the value and never let it reach the Nix store.
# NOKORIBI_QQ_BOT_CLIENT_SECRET=
# NOKORIBI_QQ_BOT_MARKDOWN=basic
# NOKORIBI_QQ_BOT_MAX_TEXT_LENGTH=4500
# NOKORIBI_QQ_BOT_MAX_REPLIES=4
# NOKORIBI_QQ_BOT_C2C_WINDOW_SECONDS=3600
# NOKORIBI_QQ_BOT_GROUP_WINDOW_SECONDS=300
# NOKORIBI_QQ_BOT_REQUEST_TIMEOUT_MS=10000
# NOKORIBI_QQ_BOT_CONNECT_TIMEOUT_MS=30000
# Active push was announced as removed on 2025-04-21 while quota tables still
# exist; proactive notices may fail and are deferred to the next inbound.
# NOKORIBI_QQ_BOT_ACTIVE_FALLBACK=auto
# C2C approval buttons; invalid values disable them (conservative).
# NOKORIBI_QQ_BOT_APPROVAL_BUTTONS=true
# M15: C2C buttons for single-select ask_user_question options.
# NOKORIBI_QQ_BOT_QUESTION_BUTTONS=true
# M14: download inbound image attachments (size/timeout guard) and the
# outbound file limit for the agent's send_to_user tool.
# NOKORIBI_QQ_BOT_INBOUND_IMAGES=true
# NOKORIBI_QQ_BOT_INBOUND_IMAGE_MAX_BYTES=10485760
# NOKORIBI_QQ_BOT_INBOUND_IMAGE_TIMEOUT_MS=15000
# NOKORIBI_SEND_FILE_MAX_BYTES=33554432
# NOKORIBI_QQ_BOT_RECONNECT_BASE_MS=1000
# NOKORIBI_QQ_BOT_RECONNECT_MAX_MS=60000
# Test/fake-server URL overrides; leave unset in production. An empty gateway
# URL resolves the WebSocket address through GET /gateway.
# NOKORIBI_QQ_BOT_API_BASE=https://api.bot.qq.com
# NOKORIBI_QQ_BOT_TOKEN_BASE=https://api.bot.qq.com
# NOKORIBI_QQ_BOT_GATEWAY_URL=ws://127.0.0.1:18080/websocket

# Goal subagents. The child model defaults to the main route. Recovery is
# bounded per goal; maxActiveSubagents is a DSH safety capacity, not a
# business concurrency cap.
# NOKORIBI_GOAL_PROVIDER=
# NOKORIBI_GOAL_MODEL=
# NOKORIBI_GOAL_REASONING_EFFORT=
# NOKORIBI_GOAL_MODELS=provider/model,provider/other-model
# NOKORIBI_GOAL_DEFAULT_MAX_ROUNDS=256
# NOKORIBI_GOAL_RECOVERY_TIMEOUT_MS=30000
# NOKORIBI_MAX_ACTIVE_SUBAGENTS=9007199254740991

# Memory. The curator defaults to the goal route and is best-effort.
# NOKORIBI_MEMORY_PROVIDER=
# NOKORIBI_MEMORY_MODEL=
# NOKORIBI_MEMORY_REASONING_EFFORT=
# NOKORIBI_MEMORY_CURATOR=true
# NOKORIBI_MEMORY_CURATOR_TIMEOUT_MS=60000
# M16: local memory tool/store and the pinned snapshot injection. Setting
# NOKORIBI_MEMORY_ENABLED=false hides the local memory row entirely (this is
# also how the OpenViking backend switch disables local memory at runtime).
# NOKORIBI_MEMORY_ENABLED=true
# NOKORIBI_MEMORY_INJECT_ENABLED=true
# NOKORIBI_MEMORY_INJECT_MAX_CHARS=3000
# NOKORIBI_MEMORY_INJECT_MAX_ENTRIES=20
# NOKORIBI_MEMORY_INJECT_MAIN_ONLY=true
# NOKORIBI_MEMORY_INJECT_AUTO_TAGS=type:person,type:preference

# M17: optional OpenViking memory backend (default off; the NixOS module maps
# services.nokoribi-agent.memory.openviking.* to these names). The launcher only
# appends the plugin bundle when NOKORIBI_OPENVIKING_ENABLED=true, forces local
# memory off and maps the connection values to the plugin's OPENVIKING_* env.
# The API key itself belongs in the systemd EnvironmentFile/agenix under the
# variable named by NOKORIBI_OPENVIKING_API_KEY_ENV.
# NOKORIBI_OPENVIKING_ENABLED=false
# NOKORIBI_OPENVIKING_ENDPOINT=https://openviking.example.invalid
# NOKORIBI_OPENVIKING_API_KEY_ENV=OPENVIKING_API_KEY
# NOKORIBI_OPENVIKING_PEER_ID=
# NOKORIBI_OPENVIKING_WORKSPACE_PEER=
# NOKORIBI_OPENVIKING_RECALL_MAX_TOKENS=

# Time context and reminders. The zone defaults to the process zone.
# NOKORIBI_TIME_ZONE=Asia/Shanghai
# NOKORIBI_TIME_CONTEXT_REFRESH_MS=60000

# Logging and launcher readiness. The NixOS module sets the readiness timeout
# to 0 so systemd owns the start deadline.
# NOKORIBI_LOG_LEVEL=info
# NOKORIBI_READY_TIMEOUT_MS=30000
# NOKORIBI_SYSTEMD_NOTIFY=systemd-notify

# Optional paths.
# NOKORIBI_WORKSPACE=
# NOKORIBI_SOUL_FILE=
# NOKORIBI_TEMPLATES_DIR=
# NOKORIBI_PATCH=

# Shell hosts. The production default is the disposable sandbox; local
# development without a Nix buildEnv can set local:workspace instead.
# NOKORIBI_DEFAULT_HOST=sandbox:default
# NOKORIBI_LOCAL_EXTRA_PATH=
# NOKORIBI_SANDBOX_BASE_ENV=
# NOKORIBI_SANDBOX_SHELL_HOOK=
# NOKORIBI_SANDBOX_TTL_MS=1800000
# NOKORIBI_SANDBOX_SWEEP_MS=60000
# NOKORIBI_SANDBOX_ALLOW_RUNTIME_PACKAGES=true
# NOKORIBI_SANDBOX_NIX=nix
# NOKORIBI_SANDBOX_NIX_TIMEOUT_MS=120000
# NOKORIBI_SANDBOX_SETPRIV=

# Persistent terminals (M10). Host-aware terminals keep shell state across tool
# calls inside one daemon process; `type` selects local:workspace or
# sandbox:default. State is in-process only: daemon restart, /clear and goal
# archival close every terminal. The NixOS module disables the terminal rows
# entirely when services.nokoribi-agent.terminal.enable = false.
# NOKORIBI_TERMINAL_ENABLED=true
# NOKORIBI_TERMINAL_BASH_PATH=bash
# NOKORIBI_TERMINAL_MAX_RESULT_BYTES=262144
# NOKORIBI_TERMINAL_SEND_TIMEOUT_MS=30000
# NOKORIBI_TERMINAL_ROWS=40
# NOKORIBI_TERMINAL_COLS=160
# NOKORIBI_TERMINAL_SCROLLBACK_LINES=10000

# Web search/fetch (M10). The default search provider reuses DEEPSEEK_API_KEY
# and spends one auxiliary model turn per search; `http` fetch is anonymous
# public HTTP and needs no key. Real calls need network access; automated tests
# use a local fake server. DEEPSEEK_SEARCH_BASE_URL overrides the search
# endpoint (useful for a local mock or a compatible proxy).
# NOKORIBI_WEB_ENABLED=true
# NOKORIBI_WEB_SEARCH_PROVIDER=deepseek-official
# NOKORIBI_WEB_FETCH_PROVIDER=http
# DEEPSEEK_SEARCH_BASE_URL=

# Session history search (M11). Five read-only tools (session_search,
# session_event_search, session_trace, session_event_trace, session_event_read)
# over a dedicated FTS5 index at $DSH_HOME/session-search.db. Cross-session
# access requires exact cwd equality with the caller; search always excludes the
# caller session. `openAt` may be startup|first-search|never (disabled forces
# never). The NixOS module exposes sessionSearch.* and overrides the rows
# directly, so these switches are for manual development deployments.
# NOKORIBI_SESSION_SEARCH_ENABLED=true
# NOKORIBI_SESSION_SEARCH_OPEN_AT=first-search
# NOKORIBI_SESSION_SEARCH_MAX_RESULTS=100
# NOKORIBI_SESSION_SEARCH_TIMEOUT_MS=30000

# Local skills (M12). Skills are directory bundles (<name>/SKILL.md) discovered
# from project roots, these custom roots, $DSH_HOME/skills and the bundled
# read-only directory. NOKORIBI_SKILL_DIRS is colon-separated. The catalog is a
# durable model-visible message and loaded bodies are model instructions, so
# only point custom roots at trusted content. The NixOS module exposes skill.*
# and defaults bundledDir to the package's share/skills.
# NOKORIBI_SKILL_ENABLED=true
# NOKORIBI_SKILL_DIRS=/etc/nokoribi/skills
# NOKORIBI_BUNDLED_SKILLS=
# NOKORIBI_SKILL_DESCRIPTION_MAX=500

# MCP servers (M13). There is no environment switch: the NixOS module generates
# one mcp-client row per services.nokoribi-agent.mcp.servers entry, and manual
# deployments overlay their own rows through NOKORIBI_PATCH (see .spec/22).
# Server env/header VALUES must be environment variable names, never secrets;
# the generated overlay renders them as runtime process.env lookups.
