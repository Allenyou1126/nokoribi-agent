{
    "name": "nokoribi-agent",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "typecheck": "tsc --noEmit",
        "check": "pnpm typecheck && pnpm lint && pnpm format:check"
    },
    "devDependencies": {
        "@types/node": "^24",
        "oxfmt": "^0.64.0",
        "oxlint": "^1.79.0",
        "typescript": "^7.0.2"
    },
    "packageManager": "pnpm@12.4.1"
}
