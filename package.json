{
    "name": "nokoribi-agent",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm -r --filter './packages/*' build",
        "test": "vitest run",
        "test:process": "pnpm build && vitest run --config vitest.process.config.ts",
        "typecheck": "pnpm build && tsc --noEmit && pnpm -r --filter './packages/*' typecheck",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "check": "pnpm typecheck && pnpm lint && pnpm format:check"
    },
    "devDependencies": {
        "@deepseek-ai/cordis": "4.0.5",
        "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
        "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-rc.3",
        "@deepseek-ai/dsh-commands": "0.2.1-rc.3",
        "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
        "@deepseek-ai/dsh-llm-mock-server": "0.2.1-rc.3",
        "@deepseek-ai/dsh-permission-presets": "0.2.1-rc.3",
        "@deepseek-ai/dsh-session": "0.2.1-rc.3",
        "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
        "@deepseek-ai/dsh-user-approval": "0.2.1-rc.3",
        "@deepseek-ai/dsh-user-questions": "0.2.1-rc.3",
        "@types/node": "^24",
        "oxfmt": "^0.64.0",
        "oxlint": "^1.79.0",
        "tsdown": "^0.23.2",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.4.1"
}
